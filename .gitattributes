# Auto detect text files and perform LF normalization
* text=auto

# Keep common source files normalized across Windows and Linux
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf

# Treat packaged/runtime binaries as binary files
*.exe binary
*.dll binary
*.bin binary
*.mmdb binary
