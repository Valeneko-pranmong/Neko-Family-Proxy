# =============================================================================
# Neko Family Proxy — Unified Discord Worker Environment Configuration Example
# File Location on Japan VPS: /etc/neko/discord.env (chmod 0600, root:root)
# =============================================================================

# Discord Webhook URL (Production secret; never commit actual webhook URL)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_WITH_YOUR_WEBHOOK_URL

# Network Interface & Port Authority
NETWORK_INTERFACE=ens5
PROXY_PORT=8388
SHADOWSOCKS_SERVICE=shadowsocks-libev.service

# Upstream Latency / Loss Probe
PING_TARGET=1.1.1.1

# Cadences & Intervals (Seconds)
HEALTH_SAMPLE_SECONDS=5
STATUS_UPDATE_SECONDS=60
TRAFFIC_SUMMARY_SECONDS=1800
TRAFFIC_MIN_REPORT_BYTES=1048576

# Staleness & Alert Cooldown
STALE_AFTER_SECONDS=30
ALERT_COOLDOWN_SECONDS=300

# Timezone & Localization
MONITOR_TIMEZONE=Asia/Bangkok

# Local Persistent State Path
STATE_PATH=/var/lib/neko/discord-state.json
